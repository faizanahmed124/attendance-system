APP_NAME=Attendance System
ENV=development

# SQLite (default, no setup needed)
DATABASE_URL=sqlite:///./attendance.db

# PostgreSQL example (uncomment and edit if you switch later):
# DATABASE_URL=postgresql://user:password@localhost:5432/attendance_db

SECRET_KEY=please-change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

FRONTEND_ORIGIN=http://localhost:5173

# ZKTeco biometric device polling - off by default. Turn on once a real
# device is configured under Integration > Biometric Devices.
ENABLE_BIOMETRIC_SYNC=false
BIOMETRIC_SYNC_INTERVAL_MINUTES=2
